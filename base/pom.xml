<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>dev.markodojkic</groupId>
    <artifactId>spring-boot-base</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-boot-base</name>
    <description>Reusable Spring Boot auto-configuration modules for the enterprise stack</description>

    <modules>
        <module>base-audit</module>
        <module>base-datasource</module>
        <module>base-aspect</module>
        <module>base-drools</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <drools.version>10.2.0</drools.version>
        <c3p0.version>0.14.2</c3p0.version>
        <aspectj.version>1.9.25.1</aspectj.version>
    </properties>
</project>
