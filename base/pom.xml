<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.markodojkic</groupId>
    <artifactId>spring-boot-base</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-boot-base</name>
    <description>Reusable Spring Boot auto-configuration modules for the enterprise stack</description>

    <modules>
        <module>base-audit</module>
        <module>base-datasource</module>
        <module>base-aspect</module>
        <module>base-drools</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <drools.version>10.1.0</drools.version>
        <c3p0.version>0.11.2</c3p0.version>
        <aspectj.version>1.9.25</aspectj.version>
    </properties>
    <build>
        <plugins>
        <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>versions-maven-plugin</artifactId>
            <version>2.22.0</version>
        </plugin>
        <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>6.46.1</version>
        </plugin>
        </plugins>
    </build>
</project>
