            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages",
          "host": ["{{baseUrl}}"],
          "path": ["api", "messages"]
        }
      }
    },
    {
      "name": "Create integration message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"hello from Postman\",\n  \"secretText\": \"private value\",\n  \"secretDate\": \"2026-01-01T00:00:00Z\",\n  \"secretBytes\": \"c2Vuc2l0aXZl\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/messages",
          "host": ["{{baseUrl}}"],
          "path": ["api", "messages"]
        }
      }
    },
