        }
      }
    },
    {
      "name": "gRPC Check Eligibility",
      "request": {
        "url": "{{grpcUrl}}",
        "protocol": "grpc",
        "grpc": {
          "method": "EligibilityGrpcService/CheckEligibility",
          "body": {
            "patient_id": "123"
          }
        }
      }
    }
  ]
