{
  "info": {
    "_postman_id": "d7d7e4a0-8d8a-4f12-9a6f-enterprise-stack",
    "name": "SpringBootSample Enterprise Stack",
    "description": "HTTP and SOAP requests for the SpringBootSample application. Update the baseUrl variable if the Codespaces URL changes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://cuddly-invention-qp4555jvp4wh4v6j-8080.app.github.dev"
    },
    {
      "key": "username",
      "value": "codespace"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "patientId",
      "value": "123"
    },
    {
      "key": "grpcUrl",
      "value": "grpcs://cuddly-invention-qp4555jvp4wh4v6j-9090.app.github.dev"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        }
      }
    },
    {
      "name": "Get development JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/token?username={{username}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "token"],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
    {
      "name": "Evaluate Drools rule",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rules/evaluate?age=42",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rules", "evaluate"],
          "query": [
            {
              "key": "age",
              "value": "42"
            }
          ]
        }
      }
    },
    {
      "name": "Create FHIR patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fhir/patient?familyName=Doe&givenName=Jane",
          "host": ["{{baseUrl}}"],
          "path": ["api", "fhir", "patient"],
          "query": [
            {
              "key": "familyName",
              "value": "Doe"
            },
            {
              "key": "givenName",
              "value": "Jane"
            }
          ]
        }
      }
    },
    {
      "name": "List integration messages",
      "request": {
        "method": "GET",
        "header": [
