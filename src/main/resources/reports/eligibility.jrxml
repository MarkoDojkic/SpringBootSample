<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="eligibility" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="patientId" class="java.lang.String"/>
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <text><![CDATA[Eligibility Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="40" width="555" height="30"/>
                <textFieldExpression><![CDATA["Patient: " + $P{patientId} + " - ELIGIBLE"]]></textFieldExpression>
            </textField>
        </band>
    </title>
</jasperReport>
